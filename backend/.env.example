# ==========================================
# Core Application Settings (Required)
# ==========================================
# DATABASE_URL: PostgreSQL connection string.
DATABASE_URL=postgres://covers:covers@localhost:5432/covers?sslmode=disable

# JWT_SECRET: Must be at least 32 random characters. Used to sign auth cookies.
JWT_SECRET=dev-only-secret-change-me-must-be-at-least-32-chars-long

# APP_BASE_URL: Public URL of the frontend (e.g. https://coverdoctor.com). Used for Stripe redirects.
APP_BASE_URL=http://localhost:5173

# GIN_MODE: Set to "release" in production to enable Secure cookies and suppress debug logs.
GIN_MODE=debug

# PORT: Port the API server listens on (default: 8080).
PORT=8080

# ==========================================
# Infrastructure Settings (Required)
# ==========================================
# REDIS_URL: Used for Asynq job queue and distributed rate limiting.
REDIS_URL=redis://localhost:6379/0

# S3 Configuration: Can point to MinIO (local dev), Cloudflare R2, or AWS S3.
# S3_ENDPOINT: The API endpoint (e.g. http://localhost:9000 for MinIO, or your R2 URL).
S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY: Storage access key id.
S3_ACCESS_KEY=MinI0
# S3_SECRET_KEY: Storage secret access key.
S3_SECRET_KEY=MinI0
# S3_BUCKET: The bucket name where covers are stored.
S3_BUCKET=coverdoctor
# S3_FORCE_PATH_STYLE: Set to 'true' for MinIO or local dev. Set to 'false' for AWS S3.
# Cloudflare R2 supports both, but 'true' is standard for generic S3-compatible APIs.
S3_FORCE_PATH_STYLE=true

# ==========================================
# Optional Third-Party Services
# ==========================================
# ANTHROPIC_API_KEY: Leave blank to use safe deterministic fallbacks for AI scoring.
ANTHROPIC_API_KEY=

# Polar Settings: Leave blank to disable billing endpoints entirely.
# Get product IDs from your Polar dashboard after creating the three plans.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_STARTER=
POLAR_PRODUCT_ID_CREATOR=
POLAR_PRODUCT_ID_PUBLISHER=
POLAR_ORGANIZATION_ID=

# ZeptoMail: Used for password reset emails.
# ZEPTOMAIL_API_KEY: Found in ZeptoMail dashboard → Mail Agent → (your agent) → API Key.
# ZEPTOMAIL_FROM_EMAIL: Must match a domain you have verified in ZeptoMail (e.g. noreply@yourdomain.com).
# Leave both blank to disable email sending (the server will still start but /auth/forgot-password returns an error).
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=

# COOKIE_DOMAIN: Leave blank when frontend and API are on the same origin (e.g. Render.com).
# Set to ".yourdomain.com" (with leading dot) when using a custom domain with subdomains.
COOKIE_DOMAIN=

# SCRAPER_API_KEY: Used to bypass Amazon anti-scraping during quarterly benchmark runs.
SCRAPER_API_KEY=

# ==========================================
# Developer / QA Settings
# ==========================================
# ADMIN_EMAILS: Comma-separated list of email addresses that always receive
# full PlanPublisher access regardless of their subscription status.
# Intended for developer testing and QA only — never share this value.
# Example: ADMIN_EMAILS=you@example.com,qa@example.com
ADMIN_EMAILS=

# ==========================================
# Google OAuth2 (Optional)
# ==========================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Under "OAuth 2.0 Client IDs" → Web application.
# Add GOOGLE_REDIRECT_URL to "Authorized redirect URIs" (exact match required).
# In Testing mode, add your own Google account email as a Test User.
# Leave all three blank to disable Google sign-in entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev:
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# Production (update to your actual API domain):
# GOOGLE_REDIRECT_URL=https://api.yourdomain.com/auth/google/callback

DATABASE_URL=postgres://covers:covers@localhost:5432/covers?sslmode=disable
PORT=8080
JWT_SECRET=dev-only-secret-change-me-must-be-at-least-32-chars-long

# Redis Configuration (Job queue & rate limiting)
REDIS_URL=redis://localhost:6379/0

# S3 Object Storage Configuration (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=covers

# Optional — leave blank to run with safe fallbacks (no real AI calls / billing disabled)
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

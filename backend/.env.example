# ==========================================
# Core Application Settings (Required)
# ==========================================
# DATABASE_URL: PostgreSQL connection string.
DATABASE_URL=postgres://covers:covers@localhost:5432/covers?sslmode=disable

# JWT_SECRET: Must be at least 32 random characters. Used to sign auth cookies.
JWT_SECRET=dev-only-secret-change-me-must-be-at-least-32-chars-long

# APP_BASE_URL: Public URL of the frontend (e.g. https://coverdoctor.com). Used for Stripe redirects.
APP_BASE_URL=http://localhost:5173

# GIN_MODE: Set to "release" in production to enable Secure cookies and suppress debug logs.
GIN_MODE=debug

# PORT: Port the API server listens on (default: 8080).
PORT=8080

# ==========================================
# Infrastructure Settings (Required)
# ==========================================
# REDIS_URL: Used for Asynq job queue and distributed rate limiting.
REDIS_URL=redis://localhost:6379/0

# S3 Configuration: Can point to MinIO (local dev), Cloudflare R2, or AWS S3.
# S3_ENDPOINT: The API endpoint (e.g. http://localhost:9000 for MinIO, or your R2 URL).
S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY: Storage access key id.
S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY: Storage secret access key.
S3_SECRET_KEY=minioadmin
# S3_BUCKET: The bucket name where covers are stored.
S3_BUCKET=covers
# S3_FORCE_PATH_STYLE: Set to 'true' for MinIO or local dev. Set to 'false' for AWS S3. 
# Cloudflare R2 supports both, but 'true' is standard for generic S3-compatible APIs.
S3_FORCE_PATH_STYLE=true

# ==========================================
# Optional Third-Party Services
# ==========================================
# ANTHROPIC_API_KEY: Leave blank to use safe deterministic fallbacks for AI scoring.
ANTHROPIC_API_KEY=

# Polar Settings: Leave blank to disable billing endpoints entirely.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_MONTHLY=
POLAR_ORGANIZATION_ID=

